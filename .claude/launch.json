{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mizan-api",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": ["-m", "uvicorn", "api.main:app", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "mizan-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 3000
    },
    {
      "name": "mizan-client",
      "runtimeExecutable": "env",
      "runtimeArgs": ["MIZAN_SITE=client", "MIZAN_WEB_DIR=web/out-client", ".venv/bin/python", "-m", "uvicorn", "api.main:app", "--port", "8001"],
      "port": 8001
    },
    {
      "name": "mizan-officer",
      "runtimeExecutable": "env",
      "runtimeArgs": ["MIZAN_SITE=officer", "MIZAN_WEB_DIR=web/out-officer", ".venv/bin/python", "-m", "uvicorn", "api.main:app", "--port", "8002"],
      "port": 8002
    }
  ]
}
